.form {
  margin-top: 16rpx;
  padding: 0 32rpx;
}

.presets {
  padding-top: 0;
}

.photo-head {
  margin-bottom: 20rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.cell {
  position: relative;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-bg);
}

.img {
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 26rpx;
}

.mask.failed {
  background: rgba(229, 72, 77, 0.7);
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  text-align: center;
  line-height: 38rpx;
  font-size: 30rpx;
}

.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  box-sizing: border-box;
}

.plus {
  font-size: 56rpx;
  line-height: 1;
  color: var(--color-text-3);
}

.delete {
  margin-top: 16rpx;
  color: var(--color-danger);
}
