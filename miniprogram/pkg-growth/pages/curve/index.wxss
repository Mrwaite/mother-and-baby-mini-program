.chart-card {
  margin-top: 24rpx;
  padding: 24rpx 16rpx;
}

.legend {
  padding: 0 16rpx 12rpx;
}

.legend-line {
  width: 32rpx;
  height: 0;
  border-top: 3rpx solid #8A8580;
  margin-right: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin: 0 8rpx 0 20rpx;
  border-radius: 50%;
  border: 4rpx solid #D9443A;
}

.chart {
  width: 100%;
  height: 640rpx;
}

.hint {
  padding: 8rpx 16rpx 0;
  text-align: center;
}

.list {
  padding: 0 32rpx;
}

.data-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.data-row:last-child {
  border-bottom: none;
}

.data-date {
  font-size: 28rpx;
}

.data-right {
  text-align: right;
}

.data-value {
  font-size: 30rpx;
  font-weight: 600;
}

.band {
  display: inline-block;
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent-bg);
  color: var(--color-accent);
  font-size: 22rpx;
}

.note {
  padding: 8rpx 8rpx 0;
  line-height: 1.5;
}
