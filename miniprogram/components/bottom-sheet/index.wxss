.sheet-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  visibility: hidden;
  transition: visibility 0s linear 0.25s;
}

.sheet-root.open {
  visibility: visible;
  transition-delay: 0s;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 10, 0, 0.35);
  opacity: 0;
  transition: opacity 0.25s;
}

.open .mask {
  opacity: 1;
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}

.open .panel {
  transform: translateY(0);
}

.handle {
  width: 72rpx;
  height: 10rpx;
  margin: 16rpx auto 0;
  border-radius: 5rpx;
  background: var(--color-border);
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 32rpx;
}

.close {
  font-size: 30rpx;
  color: var(--color-text-2);
  padding: 16rpx 0;
  position: relative;
  z-index: 1;
}

.title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.header-right {
  position: relative;
  z-index: 1;
}

.body {
  flex: 1;
  min-height: 0;
  max-height: calc(88vh - 280rpx);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.footer {
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
