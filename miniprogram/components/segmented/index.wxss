.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: var(--radius-pill);
  background: #F1ECE6;
}

.seg {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--color-text-2);
}

.seg.on {
  background: var(--color-surface);
  color: var(--color-text);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(80, 50, 30, 0.08);
}
