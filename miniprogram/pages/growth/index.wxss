.title {
  padding: 8rpx 8rpx 28rpx;
}

.age {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.latest {
  margin-top: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.link {
  font-size: 26rpx;
  color: var(--color-accent);
}

.metrics {
  display: flex;
  margin: 28rpx 0 20rpx;
}

.metric {
  flex: 1;
  min-width: 0;
}

.metric-label {
  font-size: 24rpx;
}

.metric-value {
  margin-top: 4rpx;
}

.metric-value .stat {
  font-size: 44rpx;
}

.metric-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
}

.band {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent-bg);
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 600;
}

.metric-date {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.list {
  padding: 0 32rpx;
}

.measure {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.measure:last-child {
  border-bottom: none;
}

.measure-date {
  font-size: 28rpx;
  font-weight: 600;
}

.measure-values {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.measure-value {
  display: flex;
  align-items: center;
}

.small-band {
  margin: 0 0 0 8rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
}

.milestones {
  margin-top: 32rpx;
}

.milestone {
  display: flex;
}

.ms-axis {
  position: relative;
  width: 48rpx;
  flex-shrink: 0;
}

.ms-dot {
  position: absolute;
  top: 36rpx;
  left: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-accent);
  border: 4rpx solid var(--color-accent-bg);
}

.ms-line {
  position: absolute;
  top: 72rpx;
  bottom: -36rpx;
  left: 21rpx;
  width: 2rpx;
  background: var(--color-border);
}

.milestone:last-child .ms-line {
  display: none;
}

.ms-body {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}

.ms-date {
  font-size: 26rpx;
  color: var(--color-accent);
  font-weight: 600;
}

.ms-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.ms-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}

.photo {
  width: 100%;
  height: 190rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
}
