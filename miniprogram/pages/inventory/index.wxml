<nav-bar />
<view class="page page-tab">
  <view class="title row between">
    <text class="hero">库存</text>
    <view class="row archived-toggle">
      <text class="muted small">已归档</text>
      <switch checked="{{archived}}" color="#D9443A" bindchange="onToggleArchived" />
    </view>
  </view>
  <view wx:if="{{!loaded}}" class="loading">加载中…</view>
  <!-- 已归档 -->
  <block wx:elif="{{archived}}">
    <empty wx:if="{{!archivedItems.length}}" icon="🗂" text="没有已归档的耗材" />
    <view wx:for="{{archivedItems}}" wx:key="id" class="card item archived" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row between">
        <view class="flex1">
          <text class="name">{{item.name}}</text>
          <text wx:if="{{item.spec}}" class="spec muted">{{item.spec}}</text>
        </view>
        <text class="qty">
          {{item.quantity}}
          <text class="unit muted">{{item.unit}}</text>
        </text>
      </view>
    </view>
  </block>
  <block wx:else>
    <empty wx:if="{{!groups.length}}" icon="📦" text="还没有耗材，点右下角 + 添加纸尿裤、奶粉等" />
    <!-- 低库存 -->
    <view wx:if="{{lowItems.length}}" class="low-card">
      <view class="low-title">⚠️ 库存不足 · {{lowItems.length}} 项</view>
      <view wx:for="{{lowItems}}" wx:key="id" class="low-row" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onOpen">
        <text class="flex1 ellipsis">{{item.name}}{{item.spec ? ' ' + item.spec : ''}}</text>
        <text class="low-qty">仅剩 {{item.quantity}} {{item.unit}}</text>
      </view>
    </view>
    <!-- 按分类 -->
    <view wx:for="{{groups}}" wx:key="category" wx:for-item="group">
      <view class="section-title">{{group.label}}</view>
      <view wx:for="{{group.items}}" wx:key="id" class="card item" hover-class="btn-hover" data-id="{{item.id}}" bindtap="onOpen">
        <view class="row between">
          <view class="flex1 ellipsis">
            <text class="name">{{item.name}}</text>
            <text wx:if="{{item.spec}}" class="spec muted">{{item.spec}}</text>
          </view>
          <text class="qty {{item.low ? 'low' : ''}}">
            {{item.quantity}}
            <text class="unit muted">{{item.unit}}</text>
          </text>
        </view>
        <view class="bar">
          <view class="bar-fill {{item.low ? 'low' : ''}}" style="width: {{item.percent}}%"></view>
        </view>
        <view class="faint small">低于 {{item.threshold}} {{item.unit}} 时提醒</view>
      </view>
    </view>
  </block>
  <view class="fab" hover-class="btn-hover" bindtap="onAdd">+</view>
</view>